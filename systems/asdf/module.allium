-- allium: 3

-- Specification of autolith-asdf: the ASDF definition library for
-- lode systems. The library defines one ASDF system class, the slot
-- schema a defsystem declaration uses, and the definition records
-- the lode's source files create at load. The contracts record the
-- validation split between the library and the consumer.
--
-- Responsibility split:
-- Distribution client: obtain sources, select releases, verify
-- artifacts, maintain the dependency lock.
-- ASDF: discover systems, compile, load, run tests during plugin
-- development.
-- Autolith: approve activation, register capabilities, manage
-- runtime instances, deactivate and diagnose.

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- The obligations the library owes every consumer of the schema.
-- Surfaces reference this contract.

contract ManifestSchema {
    @invariant SourceDataInert
        -- Every dependency entry contributes a load requirement on the
        -- entry name only. For a Sourced dependency, source_kind,
        -- location, ref and pin do not affect which system ASDF loads.
        -- Outside Autolith, the user provides the named systems.

    @invariant LibraryInertOutsideAutolith
        -- The library defines the system class and the slot schema. It
        -- records lode definitions at load and checks each
        -- definition's kind against the declared capabilities. It
        -- never invokes an activation entry point and never evaluates
        -- activation ordering. Loading a declared system runs ASDF's
        -- own mechanics.

    @invariant SchemaVersionIsLibraryVersion
        -- The manifest schema version is the library's own version. A
        -- manifest carries no schema version key. Compatibility is
        -- declared through :defsystem-depends-on's minimum version.

    @invariant ShapeErrorsFailAtDefinition
        -- A :depends-on entry that does not match the grammar, or a
        -- slot value of the wrong shape, fails system definition with
        -- an error. Definition-time checking covers shape only;
        -- semantic checks belong to the consumer.

    @invariant NameConflictsFailAtResolution
        -- The library parses every :depends-on entry, including two
        -- entries with the same name. The consumer resolves one
        -- implementation per name: same origin with different refs is
        -- not a conflict; different origins are a conflict and fail
        -- resolution. A name conflict that appears after resolution
        -- also fails.
}

-- The obligations around one lode's definition forms. The lode
-- author writes the forms in the lode's source. The library records
-- and checks them at load.

contract LodeDefinitions {
    record_skill: (lode: Manifest, name: String, description: String, instructions: String, links: Set<String>) -> SkillDefinition

    record_tool: (lode: Manifest, name: String, description: String, usage: String, handler: Any, links: Set<String>) -> ToolDefinition

    record_context: (lode: Manifest, name: String, description: String, links: Set<String>) -> ContextDefinition

    @invariant KindsCheckedAtLoad
        -- The library checks each recorded definition's kind against
        -- the manifest's capabilities while the lode loads. An
        -- undeclared kind fails the load. The manager does not
        -- recheck kinds.

    @invariant UnusedKindWarns
        -- A declared kind with no recorded definition at the end of
        -- the load produces a warning.

    @invariant DefinitionsAttributed
        -- Each definition records under the lode that owns the file
        -- that defined it.

    @invariant NamesUniquePerLode
        -- Within one lode, each definition name is unique. The
        -- registry is keyed by lode and name.

    @invariant RelatedLinksQueryable
        -- The registry answers queries by name and by related link.
        -- A related name with no matching definition in the lode is
        -- reported at load.

    @guidance
        -- The defcontext form is pending; the context kind records
        -- the common fields first.
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One parsed defsystem declaration of class autolith-asdf:system.
-- The consumer reads these slots around the load; ASDF ignores them.

entity Manifest {
    -- The system name.
    name: String

    -- The system version. Version requirements check against it.
    version: String

    -- Activation entry point name. Absent with no capabilities
    -- declares a library lode: the system never activates. Absent
    -- with capabilities: the lode activates from its definitions
    -- alone.
    activation: String?

    -- Registration kinds the activation may use. Absent or empty
    -- means none: an activation registers nothing. The vocabulary is
    -- the consumer's closed set; this library treats entries as
    -- opaque names.
    capabilities: Set<String>

    -- Systems whose activation must finish before this system's
    -- activation. The consumer builds the activation graph from these
    -- names and rejects cycles at resolution.
    activation_depends_on: Set<String>

    -- Code dependencies declared in :depends-on, one Dependency per
    -- entry. Author rule: each dependency appears once, in one entry.
    -- The library does not enforce this rule. The consumer resolves
    -- duplicate names at resolution.
    dependencies: Dependency with manifest = this
}

-- One :depends-on entry. Every entry contributes a load requirement
-- on its name.

entity Dependency {
    -- The name of the required system.
    name: String

    form: Plain | Versioned | Sourced

    -- The manifest that declares this entry.
    manifest: Manifest
}

variant Plain : Dependency {
    -- A bare system name. No version requirement, no source data.
}

variant Versioned : Dependency {
    -- Minimum version of the named system.
    min_version: String
}

variant Sourced : Dependency {
    -- Keyword naming the fetcher: git, http, file, or a custom kind.
    -- An unknown kind is a resolution-time error in the consumer, not
    -- a definition-time error here.
    -- Option rules per kind: git accepts :ref and :hash; http
    -- accepts :hash only; file accepts neither :ref nor :hash;
    -- :version is allowed on every kind. A custom kind accepts all
    -- three option keys.
    source_kind: String

    -- Where the source lives: a URL or a path, interpreted by the
    -- fetcher.
    location: String

    -- Default ref for kinds that resolve refs.
    ref: Ref?

    -- Exact revision pin: one GitHash or ContentDigest.
    pin: Pin?

    -- Compatibility requirement, checked against whatever
    -- implementation resolves.
    min_version: String?
}

-- One ref in a Sourced dependency entry. The kind says how the
-- fetcher resolves the designator. Only kinds that resolve refs
-- carry a ref. The ref form is (:tag name), (:branch name), or
-- (:commit hash); the keyword maps to the kinds Tag, Branch,
-- and Commit.

entity Ref {
    -- How the fetcher resolves the designator.
    kind: Tag | Branch | Commit

    -- The designator: a tag name, a branch name, or a commit hash.
    designator: String
}

variant Tag : Ref {
    -- Resolve the designator as a tag name.
}

variant Branch : Ref {
    -- Resolve the designator as a branch name.
}

variant Commit : Ref {
    -- The designator names the commit itself.
}

-- One pin in a Sourced dependency entry. The kind names the pin
-- form. The pin turns the entry into an exact requirement on that
-- source and that revision. The entry key is :hash for every
-- kind. The pin kind follows source_kind: GitHash when
-- source_kind is git; ContentDigest otherwise.

entity Pin {
    -- Which pin form the value is.
    kind: GitHash | ContentDigest

    -- The pin value: a git commit hash, or a content digest.
    value: String
}

variant GitHash : Pin {
    -- The value pins a git commit.
}

variant ContentDigest : Pin {
    -- The value pins the fetched content.
}

-- One recorded skill of one lode. The defskill form in the lode's
-- source creates it at load.

entity SkillDefinition {
    -- The lode that owns the file that defined this skill.
    lode: Manifest

    -- Unique within the lode.
    name: String

    -- Serves the person and the model.
    description: String

    -- The instruction text the model follows.
    instructions: String

    -- Names followed like hyperlinks.
    links: Set<String>
}

-- One recorded application command of one lode. The defcommand form
-- in the lode's source creates it at load.

entity ToolDefinition {
    -- The lode that owns the file that defined this command.
    lode: Manifest

    -- Unique within the lode.
    name: String

    -- Serves the person and the model.
    description: String

    -- The command's usage text.
    usage: String

    -- The function the defcommand body defined.
    handler: Any

    -- Names followed like hyperlinks.
    links: Set<String>
}

-- One recorded context contribution of one lode. The defcontext
-- form in the lode's source creates it at load.

entity ContextDefinition {
    -- The lode that owns the file that defined this context.
    lode: Manifest

    -- Unique within the lode.
    name: String

    -- Serves the person and the model.
    description: String

    -- Names followed like hyperlinks.
    links: Set<String>
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- The library records one skill the lode author defined. The kind
-- check fails the load when the manifest does not declare :skill.

rule RecordSkill {
    when: SkillRecorded(author, lode, name, description, instructions, links)
    requires: "skill" in lode.capabilities
    requires:
        not exists SkillDefinition{lode: lode, name: name}
        and not exists ToolDefinition{lode: lode, name: name}
        and not exists ContextDefinition{lode: lode, name: name}
    ensures: SkillDefinition.created(
        lode: lode,
        name: name,
        description: description,
        instructions: instructions,
        links: links
    )
}

-- The library records one application command the lode author
-- defined. The kind check fails the load when the manifest does not
-- declare :tool.

rule RecordTool {
    when: ToolRecorded(author, lode, name, description, usage, handler, links)
    requires: "tool" in lode.capabilities
    requires:
        not exists SkillDefinition{lode: lode, name: name}
        and not exists ToolDefinition{lode: lode, name: name}
        and not exists ContextDefinition{lode: lode, name: name}
    ensures: ToolDefinition.created(
        lode: lode,
        name: name,
        description: description,
        usage: usage,
        handler: handler,
        links: links
    )
}

-- The library records one context contribution the lode author
-- defined. The kind check fails the load when the manifest does not
-- declare :context.

rule RecordContext {
    when: ContextRecorded(author, lode, name, description, links)
    requires: "context" in lode.capabilities
    requires:
        not exists SkillDefinition{lode: lode, name: name}
        and not exists ToolDefinition{lode: lode, name: name}
        and not exists ContextDefinition{lode: lode, name: name}
    ensures: ContextDefinition.created(
        lode: lode,
        name: name,
        description: description,
        links: links
    )
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- Two actors touch the definition library. The lode author writes
-- the defsystem declaration and the definition forms. The consumer
-- reads the parsed slots around the load. The library treats every
-- consumer the same.

actor LodeAuthor {
    @guidance
        -- Writes one defsystem declaration and the definition forms
        -- in the lode's source. The declaration uses the slot
        -- schema: name, version, one Dependency per :depends-on
        -- entry, activation, capabilities, and activation
        -- dependencies. The definition forms are defskill,
        -- defcommand, and defcontext.
}

actor Consumer {
    -- One actor stands for every reader. Inside Autolith, the
    -- consumer duties split between the distribution client
    -- (preflight metadata, resolution, lock) and the Autolith
    -- manager (slots around the load, activation order,
    -- registration checks). Outside Autolith, the user is the
    -- consumer.
    @guidance
        -- Reads the parsed slots of one autolith-asdf:system. The
        -- consumer owns every semantic check: version requirements,
        -- the capability vocabulary, unknown source kinds, and name
        -- conflicts at resolution.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The defsystem declaration in the .asd file. The lode author
-- writes it once per lode. The library parses it at definition
-- time and fails shape errors there. The :depends-on entry
-- grammar: a plain name, a version requirement (:version "name"
-- "min"), or a full entry. A full entry is the name string, the
-- kind keyword, the location string, then options in any order:
-- :ref, :hash, :version. Each option key appears at most once; a
-- repeated key is a shape error. The declaration selects the
-- class with :defsystem-depends-on ("autolith-asdf") and
-- :class "autolith-asdf:system".

surface AuthorSurface {
    facing author: LodeAuthor
    contracts:
        demands ManifestSchema
}

-- The parsed slots of one Manifest. The distribution client
-- reads them at preflight, the manager reads them around the
-- load, and outside Autolith the user reads them.

surface ConsumerSurface {
    facing reader: Consumer
    contracts:
        demands ManifestSchema
}

-- The definition forms of one lode, while the lode loads. The
-- library records each form against the lode that owns the file
-- that defines it.

surface DefinitionSurface {
    facing author: LodeAuthor
    context lode: Manifest

    exposes:
        lode.capabilities

    provides:
        SkillRecorded(author, lode, name, description, instructions, links)
        ToolRecorded(author, lode, name, description, usage, handler, links)
        ContextRecorded(author, lode, name, description, links)

    contracts:
        demands LodeDefinitions
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "defcontext form - what does the defcontext macro take?"
